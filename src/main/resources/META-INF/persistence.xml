<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
             https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="foodflow-pu" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <!-- Managed Entity Classes -->
        <class>com.foodflow.entity.UserEntity</class>
        <class>com.foodflow.entity.StudentEntity</class>
        <class>com.foodflow.entity.MenuEntity</class>
        <class>com.foodflow.entity.AttendanceEntity</class>
        <class>com.foodflow.entity.FeedbackEntity</class>
        <class>com.foodflow.entity.ComplaintEntity</class>
        <class>com.foodflow.entity.BillEntity</class>
        <class>com.foodflow.entity.MessStaffEntity</class>
        <class>com.foodflow.entity.NotificationEntity</class>

        <properties>
            <!-- Default to MySQL JDBC Driver & URL; overrideable dynamically in AppConfig/JPAUtil -->
            <property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:mysql://localhost:3306/foodflow_db?useSSL=false&amp;allowPublicKeyRetrieval=true&amp;serverTimezone=UTC"/>
            <property name="jakarta.persistence.jdbc.user" value="root"/>
            <property name="jakarta.persistence.jdbc.password" value="root"/>

            <!-- Hibernate ORM Configurations -->
            <property name="hibernate.dialect" value="org.hibernate.dialect.MySQLDialect"/>
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <property name="hibernate.show_sql" value="false"/>
            <property name="hibernate.format_sql" value="true"/>
            <property name="hibernate.highlight_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>
